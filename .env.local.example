# Supabase — Project Settings > API (precisa do prefixo NEXT_PUBLIC_ porque o browser insere em adoption_request, votes e newsletter)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cloudinary — Dashboard > Product Environment
CLOUDINARY_CLOUD_NAME=
# base64 de "api_key:api_secret"  (echo -n "key:secret" | base64)
CLOUDINARY_AUTH=
