# Supabase — Project Settings > API Keys (local: valores do `supabase status`)
# Chave pública (sb_publishable_…): a segurança fica nas políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cloudinary — Dashboard > Cloud name (só o nome; o API Secret fica nas Edge Functions)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
